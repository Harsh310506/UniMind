# UniMind Environment Configuration (Example)
# Copy this file to .env and fill in your values

# Groq API Key (Primary LLM) - Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (for embeddings) - Get from https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/unimind?retryWrites=true&w=majority

# JWT Secret Key (generate a strong random string for production)
SECRET_KEY=change_this_to_a_strong_random_string

# JWT Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=vector_store

# Application Settings
APP_NAME=UniMind
APP_VERSION=1.0.0
DEBUG=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
